<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PdfSecurity.NetFramework</AssemblyName>
    <RootNamespace>PdfSecurityApi.Security</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Link the exact scanner sources used by the modern API to prevent security-rule drift. -->
  <ItemGroup>
    <Compile Include="..\backend\Security\PdfSecurity.cs" Link="Security\PdfSecurity.cs" />
    <Compile Include="..\backend\Security\PdfSecurityOptions.cs" Link="Security\PdfSecurityOptions.cs" />
    <Compile Include="..\backend\Security\PdfValidationResult.cs" Link="Security\PdfValidationResult.cs" />
  </ItemGroup>
</Project>
