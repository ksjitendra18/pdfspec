{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FrontendOrigins": [ "http://localhost:5173" ],
  "PdfSecurity": {
    "MaxFileSizeBytes": 10485760,
    "MaxInflateBytes": 2097152,
    "MaxTotalInflateBytes": 8388608,
    "MaxStreamCount": 256,
    "MaxCompressionRatio": 200,
    "MaxFindings": 100,
    "BlockJavaScript": true,
    "BlockExternalLinks": true,
    "BlockEmbeddedFiles": true,
    "BlockCommandExecution": true,
    "BlockAnnotationInjection": true,
    "RequirePdfHeader": true,
    "RequirePdfStructure": true,
    "RejectEncryptedPdf": true,
    "RejectUnscannableStreams": true,
    "HeaderScanBytes": 1024
  }
}
