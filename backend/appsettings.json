{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PdfSecurity": {
    "MaxFileSizeBytes": 10485760,
    "MaxInflateBytes": 2097152,
    "BlockJavaScript": true,
    "BlockExternalLinks": true,
    "BlockEmbeddedFiles": true,
    "BlockCommandExecution": true,
    "BlockAnnotationInjection": true,
    "RequirePdfHeader": true,
    "HeaderScanBytes": 1024
  }
}
